{
  "scope": "cooperative-physical-v2",
  "model": {
    "length": 64,
    "max_observations": 128,
    "d_model": 128,
    "nhead": 8,
    "num_layers": 6,
    "dim_feedforward": 256,
    "dropout": 0.1,
    "head_hidden": 64,
    "gate_floor": 0.001,
    "support_time_policy": "train_absmax_v1",
    "model_variant": "support_residual_v2"
  },
  "training": {
    "seed": 20,
    "batch_size": 64,
    "teacher_updates": 1000,
    "utility_updates": 200,
    "adapt_updates": 300,
    "learning_rate": 0.0001,
    "gradient_clip": 1.0,
    "endpoint_fraction": 0.25,
    "utility_epsilon": 0.001,
    "error_scale_policy": "training_native_std",
    "longitude_loss_mode": "shortest_arc",
    "routes": [
      "plain",
      "scalar-u",
      "attribute-u",
      "learned-attribute"
    ],
    "max_seconds": 1140.0,
    "batch_tracks": 1,
    "pair_batch_size": 1024
  },
  "data": {
    "time_unit_seconds": 20.0,
    "reference_longitude_policy": "shortest_arc"
  },
  "train_splits": [
    "T_core"
  ]
}
